{"ridley-jopling":[{"d":"rj-group","k":"enum","l":"The Ridley-Jopling group. Requires the lepromin response and histology, not just the clinical picture [TT = TT (tuberculoid), High cell-mediated resistance. BT = BT (borderline tuberculoid), Substantial but incomplete resistance. BB = BB (mid-borderline), Unstable. This is the least stable position on the spectrum, and untreated cases tend to shift toward one pole. BL = BL (borderline lepromatous), Little resistance. LL = LL (lepromatous), Little or no cell-mediated resistance. I = Indeterminate, outside the five-group spectrum]","r":1,"v":["TT","BT","BB","BL","LL","I"]}],"rifle-aki":[{"d":"ri-base","k":"number","l":"Baseline creatinine","u":"mg/dL"},{"d":"ri-curr","k":"number","l":"Current creatinine","u":"mg/dL"},{"d":"ri-uo","k":"enum","l":"Urine-output category","v":["0","1","2","3"]}],"riosord":[{"d":"rio-version","k":"enum","l":"Version","r":1,"v":["vha","commercial"]},{"d":"rio-substance-use","k":"enum","l":"Opioid dependence (veterans) or substance use disorder (commercial) visit","v":["yes","no"]},{"d":"rio-hepatitis","k":"enum","l":"Chronic hepatitis or cirrhosis (veterans version)","v":["yes","no"]},{"d":"rio-bipolar","k":"enum","l":"Bipolar disorder or schizophrenia","v":["yes","no"]},{"d":"rio-pulmonary","k":"enum","l":"Chronic pulmonary disease","v":["yes","no"]},{"d":"rio-kidney","k":"enum","l":"Kidney disease with clinically significant renal impairment","v":["yes","no"]},{"d":"rio-trauma","k":"enum","l":"An active traumatic injury, excluding burns (veterans version)","v":["yes","no"]},{"d":"rio-sleep-apnea","k":"enum","l":"Sleep apnea (veterans version)","v":["yes","no"]},{"d":"rio-stroke","k":"enum","l":"Stroke or other cerebrovascular disease (commercial version)","v":["yes","no"]},{"d":"rio-heart-failure","k":"enum","l":"Heart failure (commercial version)","v":["yes","no"]},{"d":"rio-pancreatic","k":"enum","l":"Nonmalignant pancreatic disease (commercial version)","v":["yes","no"]},{"d":"rio-headache","k":"enum","l":"Recurrent headache (commercial version)","v":["yes","no"]},{"d":"rio-erla","k":"enum","l":"An extended-release or long-acting opioid product (counted once)","v":["yes","no"]},{"d":"rio-methadone","k":"enum","l":"Methadone","v":["yes","no"]},{"d":"rio-oxycodone","k":"enum","l":"Oxycodone (veterans version)","v":["yes","no"]},{"d":"rio-fentanyl","k":"enum","l":"Fentanyl (commercial version)","v":["yes","no"]},{"d":"rio-morphine","k":"enum","l":"Morphine (commercial version)","v":["yes","no"]},{"d":"rio-hydromorphone","k":"enum","l":"Hydromorphone (commercial version)","v":["yes","no"]},{"d":"rio-antidepressant","k":"enum","l":"A prescription antidepressant","v":["yes","no"]},{"d":"rio-benzodiazepine","k":"enum","l":"A prescription benzodiazepine","v":["yes","no"]},{"d":"rio-ed-visit","k":"enum","l":"One or more emergency department visits in the past 6 months (veterans version)","v":["yes","no"]},{"d":"rio-hospitalized","k":"enum","l":"Hospitalized for one or more days in the past 6 months (veterans version)","v":["yes","no"]},{"d":"rio-mme","k":"number","l":"Maximum prescribed opioid dose","u":"MME/day","r":1}],"ripasa":[{"d":"rp-gender","k":"enum","l":"Gender (male +1 / female +0.5)","v":["male","female"]},{"d":"rp-age","k":"enum","l":"Age (<= 40 +1 / > 40 +0.5)","v":["le40","gt40"]},{"d":"rp-dur","k":"enum","l":"Symptom duration (< 48h +1 / > 48h +0.5)","v":["lt48","gt48"]},{"d":"rp-rifpain","k":"bool","l":"RIF pain (+0.5)"},{"d":"rp-migration","k":"bool","l":"Migration of pain to RIF (+0.5)"},{"d":"rp-anorexia","k":"bool","l":"Anorexia (+1)"},{"d":"rp-nausea","k":"bool","l":"Nausea & vomiting (+1)"},{"d":"rp-riftender","k":"bool","l":"RIF tenderness (+1)"},{"d":"rp-guarding","k":"bool","l":"Guarding (+2)"},{"d":"rp-rebound","k":"bool","l":"Rebound tenderness (+1)"},{"d":"rp-rovsing","k":"bool","l":"Rovsing's sign (+2)"},{"d":"rp-fever","k":"bool","l":"Fever 37-39 C (+1)"},{"d":"rp-wbc","k":"bool","l":"Raised WBC (+1)"},{"d":"rp-urine","k":"bo