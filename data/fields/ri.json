{"ridley-jopling":[{"d":"rj-group","k":"enum","l":"The Ridley-Jopling group. Requires the lepromin response and histology, not just the clinical picture [TT = TT (tuberculoid), High cell-mediated resistance. BT = BT (borderline tuberculoid), Substantial but incomplete resistance. BB = BB (mid-borderline), Unstable. This is the least stable position on the spectrum, and untreated cases tend to shift toward one pole. BL = BL (borderline lepromatous), Little resistance. LL = LL (lepromatous), Little or no cell-mediated resistance. I = Indeterminate, outside the five-group spectrum]","r":1,"v":["TT","BT","BB","BL","LL","I"]}],"rifle-aki":[{"d":"ri-base","k":"number","l":"Baseline creatinine","u":"mg/dL"},{"d":"ri-curr","k":"number","l":"Current creatinine","u":"mg/dL"},{"d":"ri-uo","k":"enum","l":"Urine-output category","v":["0","1","2","3"]}],"ripasa":[{"d":"rp-gender","k":"enum","l":"Gender (male +1 / female +0.5)","v":["male","female"]},{"d":"rp-age","k":"enum","l":"Age (<= 40 +1 / > 40 +0.5)","v":["le40","gt40"]},{"d":"rp-dur","k":"enum","l":"Symptom duration (< 48h +1 / > 48h +0.5)","v":["lt48","gt48"]},{"d":"rp-rifpain","k":"bool","l":"RIF pain (+0.5)"},{"d":"rp-migration","k":"bool","l":"Migration of pain to RIF (+0.5)"},{"d":"rp-anorexia","k":"bool","l":"Anorexia (+1)"},{"d":"rp-nausea","k":"bool","l":"Nausea & vomiting (+1)"},{"d":"rp-riftender","k":"bool","l":"RIF tenderness (+1)"},{"d":"rp-guarding","k":"bool","l":"Guarding (+2)"},{"d":"rp-rebound","k":"bool","l":"Rebound tenderness (+1)"},{"d":"rp-rovsing","k":"bool","l":"Rovsing's sign (+2)"},{"d":"rp-fever","k":"bool","l":"Fever 37-39 C (+1)"},{"d":"rp-wbc","k":"bool","l":"Raised WBC (+1)"},{"d":"rp-urine","k":"bool","l":"Negative urinalysis (+1)"},{"d":"rp-nric","k":"bool","l":"Foreign NRIC (+1)"}],"risser-sign":[{"d":"risser-grade","k":"enum","l":"Risser grade","v":["0","1","2","3","4","5"]}],"rivermead-mobility-index":[{"d":"rmi-count","k":"number","l":"Number of items achieved (0-15)","r":1}]}