{"hear":[{"d":"hr-hist","k":"enum","l":"History (slightly / moderately / highly suspicious)","v":["h0","h1","h2"]},{"d":"hr-ecg","k":"enum","l":"ECG (normal / non-specific repolarization / significant ST deviation)","v":["e0","e1","e2"]},{"d":"hr-age","k":"number","l":"Age","u":"years","r":1},{"d":"hr-risk","k":"enum","l":"Risk factors (none / 1-2 / ≥ 3 or known atherosclerotic disease)","v":["r0","r1","r2"]}],"heart":[{"d":"h-hist","k":"enum","l":"History (0 slightly / 1 moderately / 2 highly suspicious)","r":1,"v":["0","1","2"]},{"d":"h-ekg","k":"enum","l":"EKG (0 normal / 1 nonspecific / 2 significant ST deviation)","r":1,"v":["0","1","2"]},{"d":"h-age","k":"enum","l":"Age (0 < 45 / 1 45-64 / 2 >= 65)","r":1,"v":["0","1","2"]},{"d":"h-rf","k":"enum","l":"Risk factors (0 none / 1 one-two / 2 >= 3 or atherosclerosis)","r":1,"v":["0","1","2"]},{"d":"h-trop","k":"enum","l":"Troponin (0 normal / 1 1-3x ULN / 2 > 3x ULN)","r":1,"v":["0","1","2"]}],"heart-pathway":[{"d":"hp-heart","k":"number","l":"HEART score (0–10)","r":1},{"d":"hp-trop0","k":"bool","l":"0-hour troponin elevated"},{"d":"hp-trop3","k":"bool","l":"3-hour troponin elevated"}],"heat-index":[{"d":"hi-temp","k":"number","l":"Air temperature","u":"F","r":1},{"d":"hi-rh","k":"number","l":"Relative humidity","u":"%","r":1}],"heatstroke-decision":[{"d":"hs-t","k":"number","l":"Core temperature","u":"C","r":1},{"d":"hs-cns","k":"enum","l":"CNS status","r":1,"v":["none","mild-confusion","altered"]},{"d":"hs-sw","k":"bool","l":"Sweating present (exertional; unchecked = anhidrotic / classic)"},{"d":"hs-set","k":"enum","l":"Setting","r":1,"v":["field","hospital"]}],"heaven-criteria":[{"d":"heaven-hypoxemia","k":"enum","l":"H - Hypoxemia. Oxygen saturation 93 percent or below at the time of initial laryngoscopy. Assessed at the moment of laryngoscopy, not on arrival.","r":1,"v":["no","yes"]},{"d":"heaven-extremesOfSize","k":"enum","l":"E - Extremes of size. A pediatric patient 8 years of age or under, or clinical obesity that the operator anticipates will interfere with bag-valve-mask ventilation or with visualizing the glottis. Obesity is deliberately left undefined: there is no body mass index threshold. OPERATOR JUDGMENT, not a measurement. Assessed at the moment of laryngoscopy, not on arrival.","r":1,"v":["no","yes"]},{"d":"heaven-anatomicChallenge","k":"enum","l":"A - Anatomic challenge. Any structural abnormality anticipated to limit the laryngoscopic view: airway trauma, limited oral aperture, large tongue, short neck, mass or swelling, foreign body, or an external structure obstructing visualization. OPERATOR JUDGMENT, not a measurement. Assessed at the moment of laryngoscopy, not on arrival.","r":1,"v":["no","yes"]},{"d":"heaven-vomitBloodFluid","k":"enum","l":"V - Vomit, blood or fluid. Clinically significant fluid in the pharynx or hypopharynx before laryngoscopy, anticipated to interfere with bag-valve-mask ventilation or with visualizing the glottis. OPERATOR JUDGMENT, not a measurement. Assessed at the moment of laryngoscopy, not on arrival.","r":1,"v":["no","yes"]},{"d":"heaven-exsanguination","k":"enum","l":"E - Exsanguination. SUSPECTED ANEMIA, chronic or acute, raising concern about shortening safe apnea time. This is NOT active bleeding: it is anticipated desaturation reserve. OPERATOR JUDGMENT, not a measurement. Assessed at the moment of laryngoscopy, not on arrival.","r":1,"v":["no","yes"]},{"d":"heaven-neckMobility","k":"enum","l":"N - Neck mobility. Limited cervical range of motion, from immobilization or from arthritis. OPERATOR JUDGMENT, not a measurement. Assessed at the moment of laryngoscopy, not on arrival.","r":1,"v":["no","yes"]}],"heckerling-pneumonia":[{"d":"heck-fever","k":"bool","l":"Temperature > 37.8 C (100 F)"},{"d":"heck-tachy","k":"bool","l":"Heart rate > 100 /min"},{"d":"heck-crackles","k":"bool","l":"Crackles (rales) on auscultation"},{"d":"heck-breath","k":"bool","l":"Decreased breath sounds"},{"d":"heck-noasthma","k":"bool","l":"Absence of asthma (patient has no asthma)"}],"heds-2017":[{"d":"heds-beighton","k":"number","l":"Beighton score out of 9"},{"d":"heds-group","k":"enum","l":"Which Beighton cutoff applies","v":["prepubertal-or-adolescent","pubertal-to-50","over-50"]},{"d":"heds-q1","k":"bool","l":"Hands flat on the floor"},{"d":"heds-q2","k":"bool","l":"Thumb to forearm"},{"d":"heds-q3","k":"bool","l":"Contorted body as a child"},{"d":"heds-q4","k":"bool","l":"Shoulder or kneecap dislocated twice"},{"d":"heds-q5","k":"bool","l":"Considers self double-jointed"},{"d":"heds-a1","k":"bool","l":"Soft or velvety skin"},{"d":"heds-a2","k":"bool","l":"Mild skin hyperextensibility"},{"d":"heds-a3","k":"bool","l":"Unexplained striae"},{"d":"heds-a4","k":"bool","l":"Piezogenic heel papules"},{"d":"heds-a5","k":"bool","l":"Recurrent abdominal hernias"},{"d":"heds-a6","k":"bool","l":"Atrophic scarring, 2+ sites"},{"d":"heds-a7","k":"bool","l":"Pelvic, rectal or uterine prolapse"},{"d":"heds-a8","k":"bool","l":"Dental crowding, high palate"},{"d":"heds-a9","k":"bool","l":"Arachnodactyly, bilateral"},{"d":"heds-a10","k":"bool","l":"Arm span to height 1.05 or more"},{"d":"heds-a11","k":"bool","l":"Mitral valve prolapse"},{"d":"heds-a12","k":"bool","l":"Aortic root Z above 2"},{"d":"heds-family","k":"bool","l":"First-degree relative meets the criteria"},{"d":"heds-c1","k":"bool","l":"Limb pain daily for 3 months"},{"d":"heds-c2","k":"bool","l":"Chronic widespread pain"},{"d":"heds-c3","k":"bool","l":"Recurrent dislocations or instability"},{"d":"heds-skin","k":"bool","l":"No unusual skin fragility"},{"d":"heds-otherctd","k":"bool","l":"Other connective-tissue disorders excluded"},{"d":"heds-alternatives","k":"bool","l":"Alternative causes excluded"},{"d":"heds-acquired","k":"bool","l":"Patient has an acquired connective-tissue disorder"}],"heffner":[{"d":"heff-ldh","k":"number","l":"Pleural fluid LDH.","u":"U/L","r":1},{"d":"heff-uln","k":"number","l":"THE LABORATORY'S upper limit of normal for SERUM LDH - a reference value, not the patient's blood. REQUIRED AND NOT DEFAULTED: the cutoff is 0.45 times this, and it differs between laboratories and assays.","u":"U/L","r":1},{"d":"heff-chol","k":"number","l":"Pleural fluid cholesterol. Exudate above 45 mg/dL.","u":"mg/dL","r":1},{"d":"heff-protein","k":"number","l":"Pleural fluid protein. Exudate above 2.9 g/dL - NOT 3.0. This is the test the two-test rule drops.","u":"g/dL","r":1}],"hellp":[{"d":"hl-hem","k":"bool","l":"Hemolysis (abnormal smear / bilirubin >= 1.2 / LDH >= 600)"},{"d":"hl-ast","k":"bool","l":"Elevated liver enzymes (AST >= 70 U/L)"},{"d":"hl-plt","k":"bool","l":"Low platelets (< 100 x10^9/L)"},{"d":"hl-nadir","k":"number","l":"Platelet nadir for Mississippi class (x10^9/L, optional)"}],"helps2b":[{"d":"h2-birds","k":"bool","l":"Brief potentially-ictal rhythmic discharges (+2)"},{"d":"h2-periodic","k":"bool","l":"LPDs / LRDA / BIPDs (+1)"},{"d":"h2-sporadic","k":"bool","l":"Sporadic epileptiform discharges (+1)"},{"d":"h2-fast","k":"bool","l":"Periodic / rhythmic pattern > 2 Hz (+1)"},{"d":"h2-plus","k":"bool","l":"Plus features (+1)"},{"d":"h2-prior","k":"bool","l":"Prior seizure history (+1)"}],"helsinki-ct-score":[{"d":"hel-mass","k":"number","l":"Mass lesion type","r":1},{"d":"hel-size","k":"bool","l":"Mass lesion volume > 25 mL (+2)"},{"d":"hel-ivh","k":"bool","l":"Intraventricular hemorrhage (+3)","r":1},{"d":"hel-cist","k":"number","l":"Suprasellar cisterns","r":1}],"hemodynamic-suite":[{"d":"hs-co","k":"number","l":"Cardiac output","u":"L/min","r":1},{"d":"hs-hr","k":"number","l":"Heart rate","u":"bpm"},{"d":"hs-bsa","k":"number","l":"Body surface area","u":"m^2"},{"d":"hs-map","k":"number","l":"Mean arterial pressure","u":"mmHg"},{"d":"hs-cvp","k":"number","l":"Central venous pressure","u":"mmHg"},{"d":"hs-mpap","k":"number","l":"Mean pulmonary artery pressure","u":"mmHg"},{"d":"hs-pcwp","k":"number","l":"Pulmonary capillary wedge pressure","u":"mmHg"}],"hemorr2hages":[{"d":"hh-hr","k":"bool