{"buffer-ph":[{"d":"bp-pair","k":"enum","l":"Buffer pair: a weak acid and its salt, or a weak base and its salt","r":1,"v":["acid","base"]},{"d":"bp-mode","k":"enum","l":"What to work out: the pH from two concentrations (ph), or the composition for a target pH (compose)","r":1,"v":["ph","compose"]},{"d":"bp-pka","k":"number","l":"pKa at the working temperature (for a weak base, of its conjugate acid)","r":1},{"d":"bp-acceptor","k":"number","l":"pH mode: concentration of the salt (acid pair) or of the base (base pair)","u":"mol/L"},{"d":"bp-donor","k":"number","l":"pH mode: concentration of the acid (acid pair) or of the salt (base pair)","u":"mol/L"},{"d":"bp-target","k":"number","l":"Compose mode: target pH"},{"d":"bp-total","k":"number","l":"Compose mode: total buffer concentration","u":"mol/L"},{"d":"bp-vol","k":"number","l":"Compose mode: volume, for grams (optional)","u":"mL"},{"d":"bp-mwa","k":"number","l":"Compose mode: molecular weight of the salt (acid pair) or of the base (base pair), for grams","u":"g/mol"},{"d":"bp-mwd","k":"number","l":"Compose mode: molecular weight of the acid (acid pair) or of the salt (base pair), for grams","u":"g/mol"}],"buprenorphine-oud-product-switch":[{"d":"bps-switch","k":"enum","l":"From which product to which","r":1,"v":["suboxone-to-zubsolv","zubsolv-to-suboxone","sublingual-to-brixadi","brixadi-weekly-to-monthly","brixadi-monthly-to-weekly","transmucosal-to-sublocade"]},{"d":"bps-dose","k":"number","l":"Current dose: mg of buprenorphine a day (or the Brixadi weekly or monthly dose)","u":"mg","r":1},{"d":"bps-first","k":"string","l":"Date of the first injection (YYYY-MM-DD, optional)"}],"burch-wartofsky":[{"d":"bw-temp","k":"number","l":"Temperature points (0-30)","r":1},{"d":"bw-cns","k":"number","l":"CNS effects points (0-30)","r":1},{"d":"bw-gi","k":"number","l":"GI-hepatic points (0-20)","r":1},{"d":"bw-hr","k":"number","l":"Tachycardia points (0-25)","r":1},{"d":"bw-chf","k":"number","l":"Congestive heart failure poin