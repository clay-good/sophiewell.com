{"hcm-risk-scd":[{"d":"hcm-age","k":"number","l":"Age","u":"years","r":1},{"d":"hcm-mwt","k":"number","l":"Maximal LV wall thickness","u":"mm","r":1},{"d":"hcm-la","k":"number","l":"Left-atrial diameter","u":"mm","r":1},{"d":"hcm-lvot","k":"number","l":"Maximal (rest/Valsalva) LVOT gradient","u":"mmHg","r":1},{"d":"hcm-fhx","k":"bool","l":"Family history of sudden cardiac death"},{"d":"hcm-nsvt","k":"bool","l":"Non-sustained VT on Holter"},{"d":"hcm-syncope","k":"bool","l":"Unexplained syncope"}],"hcp-exposure-clock":[{"d":"hce-pathogen","k":"enum","l":"Exposed to","r":1,"v":["measles","mumps","rubella","varicella","pertussis"]},{"d":"hce-first","k":"string","l":"First exposure (YYYY-MM-DD)","r":1},{"d":"hce-last","k":"string","l":"Last exposure (YYYY-MM-DD; blank for a single exposure)"},{"d":"hce-immunity","k":"enum","l":"Immunity (measles, mumps, rubella, varicella)","v":["immune","not-immune","unknown"]},{"d":"hce-mmr","k":"enum","l":"Mumps, not immune: first MMR dose before the exposure","v":["yes","no"]},{"d":"hce-second-dose","k":"enum","l":"Varicella, not immune: one prior dose and the second within 5 days after exposure","v":["yes","no"]},{"d":"hce-varizig","k":"enum","l":"Varicella, not immune: varicella-zoster immune globulin given","v":["yes","no"]},{"d":"hce-high-risk","k":"enum","l":"Pertussis: likely to interact with persons at increased risk","v":["yes","no"]},{"d":"hce-pep","k":"enum","l":"Pertussis: receiving postexposure prophylaxis","v":["yes","no"]}],"hcp-illness-return-date":[{"d":"hci-condition","k":"enum","l":"Infection","r":1,"v":["measles","mumps-parotitis","mumps-no-parotitis","rubella","pertussis","varicella","group-a-strep","meningococcal"]},{"d":"hci-onset","k":"string","l":"Onset date: rash, parotitis, first symptom or cough (YYYY-MM-DD)"},{"d":"hci-therapy","k":"string","l":"Effective antimicrobial therapy started (YYYY-MM-DDTHH:MM)"},{"d":"hci-crusted","k":"enum","l":"Varicella: all lesions dried and crusted","v":["yes","no"]}],"hct-ci":[{"d":"hct-arrhythmia","k":"bool","l":"Arrhythmia (+1)"},{"d":"hct-cardiac","k":"bool","l":"Cardiac — CAD / CHF / MI / EF ≤ 50% (+1)"},{"d":"hct-ibd","k":"bool","l":"Inflammatory bowel disease (+1)"},{"d":"hct-diabetes","k":"bool","l":"Diabetes on treatment (+1)"},{"d":"hct-cva","k":"bool","l":"Cerebrovascular disease (+1)"},{"d":"hct-psych","k":"bool","l":"Psychiatric disturbance (+1)"},{"d":"hct-obesity","k":"bool","l":"Obesity (BMI > 35) (+1)"},{"d":"hct-infection","k":"bool","l":"Infection — antibiotics past day 0 (+1)"},{"d":"hct-rheum","k":"bool","l":"Rheumatologic disease (+2)"},{"d":"hct-ulcer","k":"bool","l":"Peptic ulcer needing treatment (+2)"},{"d":"hct-renal","k":"bool","l":"Moderate renal — Cr > 2 mg/dL / dialysis / transplant (+2)"},{"d":"hct-tumor","k":"bool","l":"Prior solid tumor (+3)"},{"d":"hct-valve","k":"bool","l":"Heart-valve disease (+3)"},{"d":"hct-hepatic","k":"enum","l":"Hepatic disease","v":["none","mild","severe"]},{"d":"hct-pulmonary","k":"enum","l":"Pulmonary disease","v":["none","moderate","severe"]}],"hcv-test-sequence":[{"d":"hcv-antibody","k":"enum","l":"HCV antibody","r":1,"v":["reactive","nonreactive"]},{"d":"hcv-rna","k":"enum","l":"HCV RNA","r":1,"v":["detected","not-detected","not-done"]},{"d":"hcv-recent","k":"enum","l":"Possible exposure in the past 6 months","r":1,"v":["yes","no"]}]}