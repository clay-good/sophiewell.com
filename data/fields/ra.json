{"rabt-score":[{"d":"ra-hr","k":"number","l":"Heart rate (beats/min)","r":1},{"d":"ra-sbp","k":"number","l":"Systolic BP (mm Hg)","r":1},{"d":"ra-pelvis","k":"bool","l":"Pelvic fracture"},{"d":"ra-pen","k":"bool","l":"Penetrating mechanism"},{"d":"ra-fast","k":"bool","l":"Positive FAST"}],"race":[{"d":"ra-face","k":"number","l":"Facial palsy (0-2)","r":1},{"d":"ra-arm","k":"number","l":"Arm motor function (0-2)","r":1},{"d":"ra-leg","k":"number","l":"Leg motor function (0-2)","r":1},{"d":"ra-gaze","k":"number","l":"Head / gaze deviation (0-1)","r":1},{"d":"ra-lang","k":"number","l":"Aphasia or agnosia (0-2)","r":1}],"rachs1":[{"d":"rachs-category","k":"enum","l":"The RACHS-1 category of the procedure performed. Examples are REPRESENTATIVE, not exhaustive [1: Secundum atrial septal defect repair; patent ductus arteriosus closure over 30 days of age; coarctation repair over 30 days of age; partial anomalous pulmonary venous return repair; aortopexy. 2: Ventricular septal defect repair; tetralogy of Fallot repair; primum atrial septal defect repair; Glenn shunt; pulmonary valvuloplasty or replacement; coarctation repair at 30 days or less; total anomalous pulmonary venous return repair over 30 days; vascular ring surgery. 3: Arterial switch operation; atrial switch operation; Fontan procedure; complete atrioventricular septal defect repair; aortic valve replacement or Ross procedure; mitral or tricuspid valve replacement; right ventricle to pulmonary artery conduit; systemic-to-pulmonary artery shunt; pulmonary artery banding. 4: Aortic valvuloplasty at 30 days or less; Konno procedure; Rastelli procedure; truncus arteriosus repair; interrupted aortic arch repair with or without ventricular septal defect repair; total anomalous pulmonary venous return repair at 30 days or less; arterial switch with ventricular septal defect closure; unifocalization for tetralogy with pulmonary atresia. 5: Tricuspid valve repositioning for neonatal Ebstein anomaly at 30 days or less; truncus arteriosus repair with interrupted aortic arch repair. Only two procedures are assigned here. 6: Norwood operation.]","r":1,"v":["1","2","3","4","5","6"]},{"d":"rachs-ageBand","k":"enum","l":"Age at surgery - a SEPARATE adjusted odds ratio, not a point added to the category [age<=30d = Age at surgery 30 days or less, odds ratio about 3; age31d-1y = Age at surgery 31 days to 1 year, odds ratio about 1.9; age>1y = Age at surgery over 1 year (the reference), odds ratio about 1]","r":1,"v":["age<=30d","age31d-1y","age>1y"]},{"d":"rachs-premature","k":"enum","l":"Prematurity? A separate adjusted odds ratio of about 1.8, not a point added to the category.","r":1,"v":["no","yes"]},{"d":"rachs-majorAnomaly","k":"enum","l":"Major non-cardiac structural anomaly? A separate adjusted odds ratio of about 1.8, not a point added to the category.","r":1,"v":["no","yes"]}],"rad-package-label-category":[{"d":"rpl-unit","k":"enum","l":"Unit of the dose rates","r":1,"v":["mrem-h","msv-h"]},{"d":"rpl-surface","k":"number","l":"Maximum dose rate at the package surface","r":1},{"d":"rpl-one-meter","k":"number","l":"Maximum dose rate at 1 meter","r":1},{"d":"rpl-hrcq","k":"enum","l":"Holds a highway route controlled quantity","r":1,"v":["yes","no"]}],"rad-package-receipt-check":[{"d":"rpr-received","k":"string","l":"Date and time received (YYYY-MM-DDTHH:MM)"},{"d":"rpr-working","k":"enum","l":"Received during normal working hours","v":["yes","no"]},{"d":"rpr-next-day","k":"string","l":"Start of the next working day, if received after hours (YYYY-MM-DDTHH:MM)"},{"d":"rpr-labeled","k":"enum","l":"Bears a White I, Yellow II or Yellow III label","v":["yes","no"]},{"d":"rpr-damaged","k":"enum","l":"Evidence of degradation (crushed, wet or damaged)","v":["yes","no"]},{"d":"rpr-gas","k":"enum","l":"Holds only a gas or special form material","v":["yes","no"]},{"d":"rpr-type-a","k":"enum","l":"Contents exceed a Type A quantity","v":["yes","no"]},{"d":"rpr-emitter","k":"enum","l":"Emitter type