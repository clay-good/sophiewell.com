{"nac-attr-stage":[{"d":"nac-bnp","k":"number","l":"NT-proBNP in ng/L; pg/mL is numerically identical, so no conversion is needed. Above 3000 moves the original stage; at or above 10000 makes it stage 4 irrespective of eGFR.","u":"ng/L","r":1},{"d":"nac-egfr","k":"number","l":"eGFR. Below 45 moves the original stage. THE SOURCE DOES NOT STATE WHICH EQUATION PRODUCED IT, and CKD-EPI and MDRD disagree by several ml/min right at this boundary.","u":"ml/min","r":1}],"nac-dosing":[{"d":"nc-weight","k":"number","l":"Body weight (kg)","r":1},{"d":"nc-reg","k":"enum","l":"IV NAC regimen","r":1,"v":["three-bag","two-bag"]}],"nacseld-aclf":[{"d":"nac-circ","k":"bool","l":"Circulatory failure (shock)"},{"d":"nac-brain","k":"bool","l":"Brain failure (grade III–IV encephalopathy)"},{"d":"nac-renal","k":"bool","l":"Renal failure (dialysis)"},{"d":"nac-resp","k":"bool","l":"Respiratory failure (mechanical ventilation)"}],"nafld-fibrosis":[{"d":"nf-age","k":"number","l":"Age","u":"years","r":1},{"d":"nf-bmi","k":"number","l":"Body mass index","u":"kg/m^2","r":1},{"d":"nf-ifg","k":"bool","l":"Impaired fasting glucose or diabetes"},{"d":"nf-ast","k":"number","l":"AST","u":"U/L","r":1},{"d":"nf-alt","k":"number","l":"ALT","u":"U/L","r":1},{"d":"nf-plt","k":"number","l":"Platelet count","u":"x10^9/L","r":1},{"d":"nf-alb","k":"number","l":"Albumin","u":"g/dL","r":1}],"naloxone":[{"d":"nx-pop","k":"enum","l":"Population","r":1,"v":["adult","pediatric"]},{"d":"nx-route","k":"enum","l":"Route (IV / IM / intranasal / SC)","r":1,"v":["iv","im","in","sc"]},{"d":"nx-w","k":"number","l":"Pediatric weight (if pediatric)","u":"kg"}],"nancy-index":[{"d":"nancy-ulceration","k":"enum","l":"Ulcers or erosions. CHECKED FIRST: their presence gives grade 4 outright, and the other two features are not consulted.","r":1,"v":["no","yes"]},{"d":"nancy-neutrophils","k":"enum","l":"Neutrophilic infiltrate. Checked SECOND, only when there is no ulceration [none = No neutrophils (fall through to the chronic infiltrate); mild = Mild increase: few or rare neutrophils in the lamina propria or epithelium, difficult to see, grade 2; moderate-severe = Moderate or severe increase: multiple clusters of neutrophils in the lamina propria and/or epithelium, easily apparent, grade 3]","v":["none","mild","moderate-severe"]},{"d":"nancy-chronic","k":"enum","l":"Chronic inflammatory infiltrate. Consulted LAST, only when neutrophils are absent, and A DEAD END AT GRADE 1 [none-or-mild = No or only mild increase in chronic inflammatory cells, grade 0; moderate-severe = Moderate or severe increase in chronic inflammatory cells (lymphocytes, plasma cells and eosinophils), easily apparent, grade 1]","v":["none-or-mild","moderate-severe"]}],"naples-prognostic-score":[{"d":"nap-alb","k":"number","l":"Serum albumin","u":"g/dL","r":1},{"d":"nap-chol","k":"number","l":"Total cholesterol","u":"mg/dL","r":1},{"d":"nap-nlr","k":"number","l":"Neutrophil-to-lymphocyte ratio (NLR)","r":1},{"d":"nap-lmr","k":"number","l":"Lymphocyte-to-monocyte ratio (LMR)","r":1}],"napsi":[{"d":"napsi-matrix","k":"number","l":"Nail matrix — quadrants involved (0-4)","r":1},{"d":"napsi-bed","k":"number","l":"Nail bed — quadrants involved (0-4)","r":1}],"narakas-obpp":[{"d":"narakas-group","k":"enum","l":"Narakas group","v":["I","II","III","IV"]}],"naranjo":[{"d":"nar-q1","k":"enum","l":"Previous conclusive reports","r":1,"v":["yes","no","unknown"]},{"d":"nar-q2","k":"enum","l":"Event after the drug was given","r":1,"v":["yes","no","unknown"]},{"d":"nar-q3","k":"enum","l":"Improved on dechallenge/antagonist","r":1,"v":["yes","no","unknown"]},{"d":"nar-q4","k":"enum","l":"Reappeared on rechallenge","r":1,"v":["yes","no","unknown"]},{"d":"nar-q5","k":"enum","l":"Alternative causes present","r":1,"v":["yes","no","unknown"]},{"d":"nar-q6","k":"enum","l":"Reappeared with placebo","r":1,"v":["yes","no","unknown"]},{"d":"nar-q7","k":"enum","l":"Drug in toxic blood concentration","r":1,"v":["yes","no","unknown"]},{"d":"nar-q8","k":"enum","l":"Dose-response relationship","r":1,"v":["yes","no","unknown"]},{"d":"nar-q9","k":"enum","l":"Prior similar reaction","r":1,"v":["yes","no","unknown"]},{"d":"nar-q10","k":"enum","l":"Confirmed by objective evidence","r":1,"v":["yes","no","unknown"]}],"narcolepsy-criteria":[{"d":"nar-sleepy","k":"bool","l":"Daily irrepressible sleep or lapses into sleep for at least three months"},{"d":"nar-cata","k":"bool","l":"Cataplexy: brief loss of muscle tone triggered by emotion"},{"d":"nar-latency","k":"number","l":"Mean sleep latency on the latency test: the threshold is 8 or less","u":"minutes"},{"d":"nar-soremp","k":"number","l":"Sleep-onset REM periods on the latency test: the threshold is 2"},{"d":"nar-psg","k":"bool","l":"A sleep-onset REM period on the overnight study, which may count as one of the two"},{"d":"nar-hcrt","k":"number","l":"Hypocretin-1 in the spinal fluid: 110 or less is type 1 on its own","u":"pg/mL"},{"d":"nar-excl","k":"bool","l":"Other causes excluded: too little sleep, obstructive apnea, a delayed sleep phase, medication"}],"nasal-o2-fio2":[{"d":"nof-flow","k":"number","l":"Oxygen flow by nasal cannula","u":"L/min","r":1}],"nascet-carotid-stenosis":[{"d":"ns-narrow","k":"number","l":"Narrowest residual lumen","u":"mm","r":1},{"d":"ns-distal","k":"number","l":"Normal distal ICA diameter","u":"mm","r":1}],"nash-moe-rotation":[{"d":"nash-moe-grade","k":"enum","l":"Nash-Moe grade","v":["0","1","2","3","4"]}],"nassar-gallbladder":[{"d":"nas-gallbladder","k":"enum","l":"Gallbladder","v":["1","2","3","4"]},{"d":"nas-pedicle","k":"enum","l":"Cystic pedicle","v":["1","2","3","4"]},{"d":"nas-adhesions","k":"enum","l":"Adhesions","v":["1","2","3","4"]}],"navy-body-fat":[{"d":"navy-sex","k":"enum","l":"Sex","r":1,"v":["male","female"]},{"d":"navy-height","k":"number","l":"Height","u":"in","r":1},{"d":"navy-neck","k":"number","l":"Neck","u":"in","r":1},{"d":"navy-waist","k":"number","l":"Waist","u":"in","r":1},{"d":"navy-hip","k":"number","l":"Hip (women only)","u":"in"}]}