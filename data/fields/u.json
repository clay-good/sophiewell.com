k","k":"number","l":"Urine K","u":"mEq/L","r":1},{"d":"uag-cl","k":"number","l":"Urine Cl","u":"mEq/L","r":1}],"urine-calcium-cr":[{"d":"uca-mode","k":"enum","l":"Mode (spot ratio or 24-hour excretion)","r":1,"v":["spot","day"]},{"d":"uca-uca","k":"number","l":"Urine calcium (spot; same mass unit as creatinine)"},{"d":"uca-ucr","k":"number","l":"Urine creatinine (spot; same mass unit as calcium)"},{"d":"uca-age","k":"enum","l":"Age band (spot)","v":["adult","infant-lt7mo","infant-7to18mo","child-19moTo6y"]},{"d":"uca-24h","k":"number","l":"24-hour urine calcium","u":"mg/day"},{"d":"uca-wt","k":"number","l":"Body weight (24-hour)","u":"kg"},{"d":"uca-sex","k":"enum","l":"Sex (24-hour)","v":["female","male"]}],"urine-osmolal-gap":[{"d":"uo-meas","k":"number","l":"Measured urine osmolality","u":"mOsm/kg","r":1},{"d":"uo-na","k":"number","l":"Urine sodium","u":"mEq/L","r":1},{"d":"uo-k","k":"number","l":"Urine potassium","u":"mEq/L","r":1},{"d":"uo-urea","k":"number","l":"Urine urea nitrogen","u":"mg/dL","r":1},{"d":"uo-glu","k":"number","l":"Urine glucose","u":"mg/dL","r":1}],"urine-output":[{"d":"uo-vol","k":"number","l":"Total urine volume","u":"mL","r":1},{"d":"uo-int","k":"number","l":"Collection interval","u":"hr","r":1},{"d":"uo-wt","k":"number","l":"Weight","u":"kg","r":1}],"ut-diabetic-foot":[{"d":"utdf-grade","k":"enum","l":"Depth grade [0 = Pre-ulcerative or post-ulcerative lesion, completely epithelialized; I = Superficial ulcer, not involving tendon, capsule or bone; II = Ulcer penetrating to tendon or capsule, without palpable bone; III = Ulcer probing to bone]. Grade 0 is a pre- or post-ulcerative epithelialized lesion, NOT \"no problem\".","r":1,"v":["0","I","II","III"]},{"d":"utdf-stage","k":"enum","l":"Complication stage [A = No infection and no ischemia; B = Infection - cellulitis, abscess or osteomyelitis; C = Ischemia; D = Both infection and ischemia]. This is the axis depth cannot see.","r":1,"v":["A","B","C","D"]}]}