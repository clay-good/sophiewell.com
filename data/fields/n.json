{"nac-attr-stage":[{"d":"nac-bnp","k":"number","l":"NT-proBNP in ng/L; pg/mL is numerically identical, so no conversion is needed. Above 3000 moves the original stage; at or above 10000 makes it stage 4 irrespective of eGFR.","u":"ng/L","r":1},{"d":"nac-egfr","k":"number","l":"eGFR. Below 45 moves the original stage. THE SOURCE DOES NOT STATE WHICH EQUATION PRODUCED IT, and CKD-EPI and MDRD disagree by several ml/min right at this boundary.","u":"ml/min","r":1}],"nac-dosing":[{"d":"nc-weight","k":"number","l":"Body weight (kg)","r":1},{"d":"nc-reg","k":"enum","l":"IV NAC regimen","r":1,"v":["three-bag","two-bag"]}],"nacseld-aclf":[{"d":"nac-circ","k":"bool","l":"Circulatory failure (shock)"},{"d":"nac-brain","k":"bool","l":"Brain failure (grade III–IV encephalopathy)"},{"d":"nac-renal","k":"bool","l":"Renal failure (dialysis)"},{"d":"nac-resp","k":"bool","l":"Respiratory failure (mechanical ventilation)"}],"nafld-fibrosis":[{"d":"nf-age","k":"number","l":"Age","u":"years","r":1},{"d":"nf-bmi","k":"number","l":"Body mass index","u":"kg/m^2","r":1},{"d":"nf-ifg","k":"bool","l":"Impaired fasting glucose or diabetes"},{"d":"nf-ast","k":"number","l":"AST","u":"U/L","r":1},{"d":"nf-alt","k":"number","l":"ALT","u":"U/L","r":1},{"d":"nf-plt","k":"number","l":"Platelet count","u":"x10^9/L","r":1},{"d":"nf-alb","k":"number","l":"Albumin","u":"g/dL","r":1}],"naloxone":[{"d":"nx-pop","k":"enum","l":"Population","r":1,"v":["adult","pediatric"]},{"d":"nx-route","k":"enum","l":"Route (IV / IM / intranasal / SC)","r":1,"v":["iv","im","in","sc"]},{"d":"nx-w","k":"number","l":"Pediatric weight (if pediatric)","u":"kg"}],"nancy-index":[{"d":"nancy-ulceration","k":"enum","l":"Ulcers or erosions. CHECKED FIRST: their presence gives grade 4 outright, and the other two features are not consulted.","r":1,"v":["no","yes"]},{"d":"nancy-neutrophils","k":"enum","l":"Neutrophilic infiltrate. Checked SECOND, only when there is no ulceration [none = No neutrophils (fall through to the chronic inf