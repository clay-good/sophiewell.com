{"yamaguchi-aosd":[{"d":"yam-fever","k":"bool","l":"MAJOR: fever ≥ 39°C lasting ≥ 1 week"},{"d":"yam-arthralgia","k":"bool","l":"MAJOR: arthralgia lasting ≥ 2 weeks"},{"d":"yam-rash","k":"bool","l":"MAJOR: typical salmon-pink macular/maculopapular rash during fever"},{"d":"yam-leuko","k":"bool","l":"MAJOR: leukocytosis ≥ 10,000/mm³ with ≥ 80% granulocytes"},{"d":"yam-throat","k":"bool","l":"MINOR: sore throat"},{"d":"yam-lymph","k":"bool","l":"MINOR: lymphadenopathy and/or splenomegaly"},{"d":"yam-liver","k":"bool","l":"MINOR: liver dysfunction (elevated transaminases/LDH)"},{"d":"yam-rfana","k":"bool","l":"MINOR: negative rheumatoid factor AND negative ANA"},{"d":"yam-infection","k":"bool","l":"EXCLUSION: infection (e.g. sepsis, infectious mononucleosis)"},{"d":"yam-malignancy","k":"bool","l":"EXCLUSION: malignancy (e.g. malignant lymphoma)"},{"d":"yam-rheumatic","k":"bool","l":"EXCLUSION: other rheumatic disease (e.g. polyarteritis nodosa, rheumatoid vasculitis)"}],"yaws-test-and-treat":[{"d":"yw-age","k":"number","l":"Age in years","r":1},{"d":"yw-weight","k":"number","l":"Weight in kg (for 30 mg/kg)"},{"d":"yw-endemic","k":"enum","l":"Lives or lived where yaws is or was endemic","r":1,"v":["no","yes"]},{"d":"yw-lesion","k":"enum","l":"Yaws-like skin lesion","r":1,"v":["no","yes"]},{"d":"yw-rdtc","k":"enum","l":"Rapid test: control line visible","v":["no","yes"]},{"d":"yw-rdtt","k":"enum","l":"Rapid test: treponemal line visible","v":["no","yes"]},{"d":"yw-dppc","k":"enum","l":"DPP: control line visible","v":["no","yes"]},{"d":"yw-dppt","k":"enum","l":"DPP: treponemal (T) line visible","v":["no","yes"]},{"d":"yw-dppnt","k":"enum","l":"DPP: non-treponemal line visible","v":["no","yes"]},{"d":"yw-pcr","k":"enum","l":"PCR","v":["pos","neg","notdone"]}]}