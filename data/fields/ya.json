{"yamaguchi-aosd":[{"d":"yam-fever","k":"bool","l":"MAJOR: fever ≥ 39°C lasting ≥ 1 week"},{"d":"yam-arthralgia","k":"bool","l":"MAJOR: arthralgia lasting ≥ 2 weeks"},{"d":"yam-rash","k":"bool","l":"MAJOR: typical salmon-pink macular/maculopapular rash during fever"},{"d":"yam-leuko","k":"bool","l":"MAJOR: leukocytosis ≥ 10,000/mm³ with ≥ 80% granulocytes"},{"d":"yam-throat","k":"bool","l":"MINOR: sore throat"},{"d":"yam-lymph","k":"bool","l":"MINOR: lymphadenopathy and/or splenomegaly"},{"d":"yam-liver","k":"bool","l":"MINOR: liver dysfunction (elevated transaminases/LDH)"},{"d":"yam-rfana","k":"bool","l":"MINOR: negative rheumatoid factor AND negative ANA"},{"d":"yam-infection","k":"bool","l":"EXCLUSION: infection (e.g. sepsis, infectious mononucleosis)"},{"d":"yam-malignancy","k":"bool","l":"EXCLUSION: malignancy (e.g. malignant lymphoma)"},{"d":"yam-rheumatic","k":"bool","l":"EXCLUSION: other rheumatic disease (e.g. polyarteritis nodosa, rheumatoid vasculitis)"}]}