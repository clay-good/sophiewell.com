{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sophiewell-reports",
  "main": "report-worker.mjs",
  "compatibility_date": "2026-08-23",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "REPORT_HASH_SECRET"]
  },
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": ["17 5 * * *"]
  },
  "routes": [
    {
      "pattern": "https://sophiewell.com/api/reports",
      "zone_name": "sophiewell.com"
    },
    {
      "pattern": "https://sophiewell.com/api/reports/config",
      "zone_name": "sophiewell.com"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEZXZuIJXp7xfP0j",
    "REPORT_ALLOWED_ORIGINS": "https://sophiewell.com",
    "REPORT_DAILY_LIMIT": "200",
    "REPORT_REPORTER_DAILY_LIMIT": "5"
  },
  "d1_databases": [
    {
      "binding": "REPORTS_DB",
      "database_name": "sophiewell-reports",
      "database_id": "1901d20a-afe5-4d5a-8ed5-60f0bf97f891",
      "migrations_dir": "migrations"
    }
  ]
}
